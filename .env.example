# Anthropic API key — used for the app being observed, for replay runs, and
# for the LLM-as-judge scorers. The SDK refuses to make calls without this
# set, and the backend refuses to start.
ANTHROPIC_API_KEY=

# Encrypts provider API keys at rest. Anthropic keys are stored ENCRYPTED
# rather than hashed, because unlike a password or an ingest key they have to
# be sent back out in a request header — so the key material lives here, out
# of the database, and a Postgres dump on its own decrypts nothing.
#
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP. Lose it and every stored provider key has to be entered again.
# Rotating it means re-encrypting every row.
OBS_SECRET_KEY=

# --- SDK export ------------------------------------------------------------
# console (default) | otlp | both
OBS_EXPORTER=console
# Ingest key from backend/scripts/bootstrap.py. Required when exporting otlp.
# Local-only credential: authenticates the SDK to your own backend.
OBS_API_KEY=
OBS_OTLP_ENDPOINT=http://localhost:8000/v1/traces

# --- Backend ---------------------------------------------------------------
OBS_DATABASE_URL=postgresql://localhost:5432/obs
# Deployed stack only (deploy/RUNBOOK.md). compose.yaml builds the container's
# OBS_DATABASE_URL from this and passes it to Postgres as its superuser
# password, so the two can never disagree. Unused when running locally against
# your own Postgres. Generate with: openssl rand -hex 32
# Must be URL-safe — it is interpolated into OBS_DATABASE_URL, and base64's
# `/` and `+` truncate the URL. Hex avoids the whole problem.
# POSTGRES_PASSWORD=
# local (default, no credentials needed) | s3
OBS_STORAGE_BACKEND=local
# OBS_S3_BUCKET=
# Where local Parquet and the WAL are written. Defaults to ./data (gitignored).
# OBS_DATA_DIR=
# WAL is compacted into Parquet on whichever threshold trips first.
OBS_WAL_FLUSH_SECONDS=10
OBS_WAL_FLUSH_SPANS=500

# --- UI login (step 2b) ----------------------------------------------------
# Seeded into the users table on first boot and hashed with argon2id. The
# plaintext is never stored. Use a real password from a password manager —
# this login is reachable by anyone who can reach the app, and the plan is to
# expose it via tunnel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Scorers (step 4) ------------------------------------------------------
# Hard cap on judge calls per scoring job, counted as items x scorers. Separate
# from OBS_MAX_RUN_ITEMS on purpose: an 80-case run scored by two judges is 80
# replay calls and 160 judge calls, and one shared budget would let either side
# starve the other. Exceeding this is refused outright rather than truncated —
# a mean over whichever items fit under a cap is silently biased by dataset
# order, which is worse than no score at all.
OBS_MAX_SCORER_CALLS=100
# How many judge calls run concurrently. Same reasoning as OBS_RUN_CONCURRENCY.
OBS_SCORING_CONCURRENCY=4

# --- Guardrails (step 6) ---------------------------------------------------
# The guardrail endpoint runs inline in an application's request path, so its
# cost control is a rate rather than a per-job budget: the run and scoring caps
# bound something that ends, and this bounds something that runs forever.
# Counted in judge calls (one per enabled guardrail per check), because that is
# the billable unit. Over the cap is a 429 — a check that quietly skipped half
# its guardrails would answer `pass` while meaning `unknown`.
OBS_MAX_GUARDRAIL_CALLS_PER_MIN=120
# Seconds one judge call gets before it is abandoned. The ceiling here is a
# waiting user's patience, not the model's — a judge that blows through this is
# resolved by the guardrail's own on_error policy and the check is marked
# degraded.
OBS_GUARDRAIL_TIMEOUT_SECONDS=10
# How many of a check's guardrails run at once. A check's latency is its
# slowest judge rather than the sum, which is the whole reason this isn't 1.
OBS_GUARDRAIL_CONCURRENCY=8
# Where obs_sdk.guard() posts. Same origin and same ingest key as the OTLP
# exporter — the application holds a key, not a cookie.
OBS_GUARDRAIL_ENDPOINT=http://localhost:8000/v1/guardrail

# --- Replay runs (step 3) --------------------------------------------------
# Hard cap on LLM calls per run. A run replays one live, billable call per test
# case, so this is the ceiling on what a single click can spend. Enforced at
# run creation: a larger dataset is truncated and the run says so.
OBS_MAX_RUN_ITEMS=100
# How many test cases run concurrently. The limit here is the Anthropic rate
# limit, not local CPU — raise it if runs feel slow and you aren't seeing 429s.
OBS_RUN_CONCURRENCY=4

# --- Cookies ---------------------------------------------------------------
# Whether the session cookie is marked Secure, i.e. HTTPS-only.
#
# **Defaults to true**, which is the direction that fails safe: forget it on a
# live host and the cookie is still HTTPS-only; forget it locally and you get
# an immediate, obvious failure instead of a silent exposure.
#
# Set it to false ONLY for plain-HTTP local development. A Secure cookie is
# dropped by the browser over http://, and the symptom is nasty to diagnose:
# the login call returns 200, then every request afterwards 401s and bounces
# you back to the login form as though the password were wrong.
#
#   local dev over http://localhost   -> false  (what a checked-out repo wants)
#   a live https:// URL               -> true   (or just leave it unset)
#   plain HTTP on a trusted LAN       -> false, plus OBS_ALLOW_INSECURE_COOKIES=true
#
# config.py::check_cookie_security refuses to boot on a non-loopback bind with
# this false, the same way check_password_strength refuses a weak password
# there — the bind address is what decides whether the exposure is real.
OBS_COOKIE_SECURE=false

# SameSite policy. "lax" is correct for this app even on a live URL: the
# frontend proxies /api to the backend (see web/next.config.ts), so there is a
# single origin and nothing is cross-site. Only set "none" if you genuinely
# split the frontend and backend across domains — and then Secure must be true,
# because browsers discard a SameSite=None cookie that is not Secure.
OBS_COOKIE_SAMESITE=lax

# Escape hatch for serving plain HTTP on a network you trust — reaching the app
# from a phone on your own Wi-Fi, for instance. It only relaxes the Secure
# check; it cannot make SameSite=None work without Secure, because that is a
# combination browsers reject rather than a risk to accept.
OBS_ALLOW_INSECURE_COOKIES=false

# --- Invite links ----------------------------------------------------------
# The address other people reach this app on. Invite and password-reset links
# are built from it.
#
# Leave it unset for local development: the link then uses whatever origin you
# are browsing, which is right through a tunnel and on a deployed host. The one
# case it gets wrong is the common one on a laptop — an invite created at
# http://localhost:3000 carries "localhost" to whoever you send it to, where it
# points at *their* machine. The People page warns when a link comes out that
# way.
#
# This cannot create reachability, only name it. A LAN address works for people
# on your network; a public hostname or tunnel URL is what works for everyone
# else. Set it to the same origin the UI is served from — one origin, since the
# frontend proxies /api to the backend.
#
# OBS_PUBLIC_URL=https://observability.example.com
